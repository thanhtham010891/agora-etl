KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=commerce.orders.v1
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
POSTGRES_DSN=postgresql://agora:agora@localhost:15432/agora_demo
REDIS_URL=redis://localhost:16379/0
REDIS_KEY_PREFIX=demo:orders
REDIS_ORDER_TTL_SECONDS=604800
PROJECTION_BATCH_SIZE=500
PROJECTION_FLUSH_INTERVAL_MS=250
PROJECTION_POLL_TIMEOUT_MS=250
PROJECTION_IDLE_POLLS=3
PROJECTION_IDLE_LOG_INTERVAL_SECONDS=60
PROJECTION_ERROR_BACKOFF_SECONDS=5
PROJECTION_MAX_CONSECUTIVE_ERRORS=5
POSTGRES_PIPELINE_ID=order-postgres-projection
POSTGRES_PROCESS_NAME=order-postgres-worker
POSTGRES_GROUP=order-postgres-v1
POSTGRES_MAPPER_NAME=map-kafka-ledger-row
REDIS_PIPELINE_ID=order-redis-projection
REDIS_PROCESS_NAME=order-redis-worker
REDIS_GROUP=order-redis-v1
REDIS_MAPPER_NAME=map-current-order-cache-row
EVENT_LEDGER_TABLE=order_event_ledger
CURRENT_STATE_TABLE=order_current_state
DLQ_TABLE=agora_dlq
PRODUCER_RUNS_TABLE=order_producer_runs
REPLAY_REQUESTS_TABLE=order_dlq_replay_requests
REPLAY_AUDIT_TABLE=order_dlq_replay_audit
SCHEMA_MIGRATIONS_TABLE=agora_schema_migrations
CRASH_MARKER_PATH=.demo-state/postgres-flushed.marker
DLQ_INSPECTION_LIMIT=100
VERIFY_REDIS_MGET_CHUNK_SIZE=500
VERIFY_SAMPLE_ORDER_LIMIT=5
# Set METRICS_PORT when running a projection process outside Compose.
# Each Compose worker exposes its own native Agora /metrics, /health, and /ready on port 8080.
METRICS_HOST=0.0.0.0
METRICS_PORT=
METRICS_AUTH_TOKEN=
