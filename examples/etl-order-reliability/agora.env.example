LOG_LEVEL=INFO
AGORA_ENV=dev

REDIS_URL=redis://localhost:16379
REDIS_DLQ_PREFIX=agora:dlq:orders-demo
REDIS_DEDUP_PREFIX=agora:dedup:orders-demo:
REDIS_CHECKPOINT_PREFIX=agora:checkpoint:orders-demo:

KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:19093,localhost:19094
KAFKA_ENV=demo
KAFKA_RAW_TOPIC=demo.orders.raw
KAFKA_CLEAN_TOPIC=demo.orders.cleaned
KAFKA_RAW_GROUP_ID=orders-normalizer
KAFKA_CLEAN_GROUP_ID=orders-projector

POSTGRES_DATABASE_URL=postgresql://agora:agora@localhost:5432/agora_test
POSTGRES_PROJECTION_TABLE=public.order_projection

WORKER_BATCH_FLUSH_INTERVAL_MS=100
SAMPLE_RECORDS_PER_RUN=5000
SAMPLE_DUPLICATE_EVERY=250
SAMPLE_POISON_EVERY=1000
SAMPLE_WRITER_BATCH_SIZE=500
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
HEALTH_AUTH_TOKEN=
